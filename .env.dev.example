# Build
ENV=dev
USE_NEXUS=false
NEXUS_NPM_REGISTRY=https://nexus.company.com/repository/npm-all

# Nextjs
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# local - вход по локальным аккаунтам из БД (POST /auth/login),
# ldap - вход через LDAP (POST /auth/ldap/login)
NEXT_PUBLIC_AUTH_MODE=local
NEXT_TELEMETRY_DISABLED=1

# Nginx
SERVER_NAME=localhost
SSL_CERT_PATH=/etc/nginx/ssl/dev/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/dev/privkey.pem

# Backend
FRONTEND_URL=http://localhost:3001
JWT_SECRET=dev-only-secret-change-me
# true - разрешает локальный вход POST /auth/login (для dev), на проме не задавать
AUTH_LOCAL_LOGIN=true

# Mail reports (dd-yesterday-findings)
SMTP_HOST=smtp.mail.local
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DD_REPORT_MAIL_FROM=report@example.com
DD_REPORT_MAIL_TO=security@example.com
DD_REPORT_MAIL_ERROR_TO=admin@example.com
DD_REPORT_CRON=0 8 * * *

# Database
DATABASE_URL=postgresql://vulnsync:vulnsync@localhost:9876/vulnsync
POSTGRES_DB=vulnsync
POSTGRES_USER=vulnsync
POSTGRES_PASSWORD=vulnsync

# LDAP
LDAP_URL=ldap://ldap.company.local:389
LDAP_BIND_DN=cn=admin,dc=company,dc=local
LDAP_BIND_PASSWORD=secret
LDAP_SEARCH_BASE=dc=company,dc=local
LDAP_ADMIN_GROUP_DN=cn=admin,OU=Groups,dc=company,dc=local
LDAP_VIEWER_GROUP_DN=cn=viewer,OU=Groups,dc=company,dc=local
LDAP_USER_GROUP_DN=cn=user,OU=Groups,dc=company,dc=local
