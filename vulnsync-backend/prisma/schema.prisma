generator client {
  provider = "prisma-client"
  output     = "./generated"
  moduleFormat = "cjs" 
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String?
  ldapDn      String?
  email       String?
  displayName String?
  jobTitle    String?
  role        String   @default("USER")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IntegrationSetting {
  id                     String @id @default(uuid())
  type                   String
  baseUrl                String
  apiToken               String?
  username               String?
  password               String?
  severityCustomField    String?
  cvssCustomField        String?
  vulnerabilityIdCustomField String?
  systemPrompt             String?
  model                    String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model JiraMapping {
  id              String @id @default(uuid())
  ddProductTypeId Int?
  fields          Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DependencyTrackMapping {
  id              String @id @default(uuid())
  ddProductId Int?
  dtProjectName   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProductTypeNotification {
  id              String   @id @default(uuid())
  ddProductTypeId Int      @unique
  emails          String // список адресов через запятую или с новой строки
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VulnerabilitySync {
  id           String   @id @default(uuid())
  externalId   String   // finding.id из DefectDojo
  source       String   // DEFECTDOJO
  jiraIssueKey String?
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([externalId, source])
}

model Log {
  id         String   @id @default(uuid())
  action     String
  ip         String?
  userId     String?
  meta       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
