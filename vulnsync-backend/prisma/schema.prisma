generator client {
  provider = "prisma-client"
  output     = "./generated"
  moduleFormat = "cjs" 
}

datasource db {
  provider = "postgresql"
}

// Роль пользователя: USER — обычный пользователь, VIEWER — техучётки из LDAP
// (пайплайны), ADMIN — администратор.
enum Role {
  USER
  VIEWER
  ADMIN
}

// Внешние системы, настройки которых хранятся в IntegrationSetting.
enum IntegrationType {
  ML
  DEFECTDOJO
  DEPENDENCY_TRACK
  JIRA
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String?
  ldapDn      String?
  email       String?
  displayName String?
  jobTitle    String?
  role        Role     @default(USER)
  // Группы продуктов DefectDojo, доступные пользователю с ролью USER.
  // Пустой массив означает отсутствие доступа; ADMIN и VIEWER не ограничены.
  allowedProductTypeIds Int[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IntegrationSetting {
  id                         String          @id @default(uuid())
  type                       IntegrationType @unique
  baseUrl                    String
  apiToken                   String?
  username                   String?
  password                   String?
  severityCustomField        String?
  cvssCustomField            String?
  vulnerabilityIdCustomField String?
  systemPrompt               String?
  model                      String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
}

model JiraMapping {
  id              String   @id @default(uuid())
  ddProductTypeId Int      @unique
  fields          Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DependencyTrackMapping {
  id            String   @id @default(uuid())
  ddProductId   Int      @unique
  dtProjectName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProductTypeNotification {
  id              String   @id @default(uuid())
  ddProductTypeId Int      @unique
  emails          String // список адресов через запятую или с новой строки
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VulnerabilitySync {
  id           String   @id @default(uuid())
  externalId   String   // finding.id из DefectDojo
  source       String   // DEFECTDOJO
  jiraIssueKey String?
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([externalId, source])
}

model Log {
  id    String @id @default(uuid())
  action String
  // Источник события (сервис/контроллер) и описание операции
  service     String?
  description String?
  userId      String?
  username    String?
  // Source IP (клиент) и Destination IP (хост приложения)
  ip            String?
  destinationIp String?
  meta          Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([username])
}

// Очередь отправки отчётов: разгружает DefectDojo и SMTP при массовых
// запусках (например, еженедельные отчёты по всем продуктам).
// Пункт удаляется при выполнении; уникальность не даёт поставить дубль,
// пока отчёт ещё не отправлен.
model ReportQueueItem {
  id         String   @id @default(uuid())
  type       String
  externalId String
  runAt      DateTime
  createdAt  DateTime @default(now())

  @@unique([type, externalId])
  @@index([runAt])
}
